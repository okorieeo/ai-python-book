# deploy/.env.production.example  (Chapter 54)
# Lists EVERY variable the compose file needs. Safe to commit: values are placeholders.
# The real values live only in Dokploy (Environment tab) and in your password manager.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME_generate_with_python_secrets
DEBUG=false
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_PROXY_COUNT=1

# Copy the internal host and credentials from the database's page in Dokploy
DATABASE_URL=postgres://chat:CHANGE_ME@chat-db-xxxxxx:5432/chat
REDIS_URL=redis://default:CHANGE_ME@chat-redis-xxxxxx:6379/0

LLM_API_KEY=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
PAYSTACK_SECRET_KEY=CHANGE_ME

# Public values: baked into the browser bundle at BUILD time, so changing them needs a rebuild
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com
