{
  "permissions": {
    "allow": [
      "Bash(python -m tools.*)",
      "Bash(python manage.py test*)",
      "Bash(python -m unittest*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(docker compose down -v*)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
