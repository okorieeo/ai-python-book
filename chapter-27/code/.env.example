# Copy to .env and fill in. .env must NEVER be committed (Chapter 17).
ANTHROPIC_API_KEY=
# Optional: only if you want to try OpenAI
OPENAI_API_KEY=
# Optional: the model your code uses by default. Change it here, not in code.
AI_DEFAULT_MODEL=claude-sonnet-5-5
# Optional: a local OpenAI-compatible server (Ollama's default address shown)
LLM_BASE_URL=http://localhost:11434/v1
EMBED_BASE_URL=http://localhost:11434/v1
