# Copy to .env (never commit .env). Compose reads it for the ${VARIABLES} in compose.yaml.

# Which files make up this environment. On Windows, separate them with ; instead of :
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Production: COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Image tag: use the Git commit in production (Chapter 51)
APP_VERSION=dev

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=change-me-use-a-long-random-value
TRUSTED_PROXY_COUNT=0

POSTGRES_USER=chat
POSTGRES_DB=chat
POSTGRES_PASSWORD=change-me-use-a-long-random-value

# Public values baked into the Next.js build (Chapter 51). Never secrets.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
