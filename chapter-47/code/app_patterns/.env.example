# Copy to .env (never commit it). These two are PUBLIC: Expo copies them into the app, so anyone
# can read them. Addresses only. No secrets, ever.
# A phone or emulator cannot reach "localhost" on your computer: use your computer's address on
# the same network (for example http://192.168.1.20:8000), or the Android emulator's 10.0.2.2.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
EXPO_PUBLIC_WS_URL=ws://192.168.1.20:8000
